  <style type="text/css" >
    .cstyle
    {
    	font-family:Trebuchet MS;   
    	font-size:medium; 	
        
     	color:Black;  
     	   	
    }  
        .menuTabs
        {
            position:relative;
            top:1px;
            left:10px;
        }
        .tab
        {
            border:Solid 1px black;           
            padding:4px 4px;
            
        }
        .selectedTab
        {
            border:Solid 1px black;
            border-bottom:Solid 1px white;
            padding:4px 4px;
            background-color:#008080;
        }
        .tabBody
        {
            border:Solid 1px black;
            padding:20px;           
            
        }
          #ContentPlaceHolder1_menuTabs a.static 
        { 
             border:Solid 1px black;
            border-bottom:Solid 1px white;
            padding:4px 4px;
            background-color:white;
            color:black;
            width:120px;

        }
        #ContentPlaceHolder1_menuTabs a.static.selected
        {
            border:Solid 1px black;
            border-bottom:Solid 1px white;
            padding:4px 4px;
            background-color:teal;
            color:white;
            width:120px;
        }
          div.radiolist
          {
              line-height:20px;
          }
          div.radiolist label
          {
              padding-left:9px;
          }
